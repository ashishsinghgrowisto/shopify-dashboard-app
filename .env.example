# ═══════════════════════════════════════════════════════════════════
# STORES — the only required configuration
# ═══════════════════════════════════════════════════════════════════
# Each connected Shopify store needs a domain, a label, and an Admin API
# access token that has the read_reports scope.
#
# Option A — one store per numbered block (easiest to manage in the Vercel UI):

STORE_1_LABEL=ColorProof
STORE_1_DOMAIN=colorproof.myshopify.com
STORE_1_TOKEN=shpat_replace_me

STORE_2_LABEL=NeumaBeauty
STORE_2_DOMAIN=neumabeauty.myshopify.com
STORE_2_TOKEN=shpat_replace_me

# ...up to STORE_40. Optional per store:
# STORE_1_KEY=cp          (URL-safe id; auto-derived from the label if omitted)
# STORE_1_COLOR=#818CF8   (chart colour; auto-assigned if omitted)

# Option B — all stores in one JSON array (easiest to paste in bulk):
# SHOPIFY_STORES=[{"label":"ColorProof","domain":"colorproof.myshopify.com","token":"shpat_xxx"},{"label":"NeumaBeauty","domain":"neumabeauty.myshopify.com","token":"shpat_yyy"}]


# ═══════════════════════════════════════════════════════════════════
# ACCESS CONTROL — strongly recommended
# ═══════════════════════════════════════════════════════════════════
# The dashboard shows every client's revenue side by side. Without a password
# anyone with the URL can read it.
DASHBOARD_USER=growisto
DASHBOARD_PASSWORD=


# ═══════════════════════════════════════════════════════════════════
# PERFORMANCE
# ═══════════════════════════════════════════════════════════════════
# Ranges that include today change as orders land, so they're cached briefly.
# Completed ranges never change, so they're cached hard. Seconds.
CACHE_TTL_LIVE=300
CACHE_TTL_CLOSED=21600

# How many stores to query at once. Each store has its own ShopifyQL budget,
# so this can be as high as your store count.
STORE_CONCURRENCY=6

# Shopify Admin API version. Must be 2025-10 or later for shopifyqlQuery.
SHOPIFY_API_VERSION=2026-07


# ═══════════════════════════════════════════════════════════════════
# DEMO MODE
# ═══════════════════════════════════════════════════════════════════
# Renders the full dashboard with synthetic data — useful before any real
# token exists. Also available per-request as ?mock=1 on /api/dashboard.
MOCK_DATA=0


# ═══════════════════════════════════════════════════════════════════
# OPTIONAL — OAuth install flow (only if you distribute this as a real app)
# ═══════════════════════════════════════════════════════════════════
# Lets a store be connected by visiting /api/auth/install?shop=x.myshopify.com
# instead of pasting a token. Requires a Shopify app (Partner Dashboard) and,
# for public distribution, Shopify App Store review.
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_SCOPES=read_reports

# Where OAuth tokens are persisted. Without these, OAuth-installed tokens live
# only in memory and are lost when the serverless instance recycles.
# Vercel → Storage → Upstash Redis sets these automatically.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
